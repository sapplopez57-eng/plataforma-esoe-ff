# Copie este archivo como .env y complete los valores. El archivo .env nunca se versiona.

NODE_ENV=production
PORT=8080

# --- Base de datos -----------------------------------------------------------
# Contrasena del usuario esoe_admin de PostgreSQL.   openssl rand -hex 24
DB_PASSWORD=

# --- Inicio de sesion (Clerk) -------------------------------------------------
# Panel de Clerk > API keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Opcional. Llave publica PEM de la instancia (API keys > JWKS Public Key), en una
# sola linea con \n. Permite verificar sesiones sin llamar a Clerk en cada arranque.
CLERK_JWT_KEY=
# URL publica de la plataforma, sin barra final. Solo se aceptan sesiones emitidas para ella.
ORIGEN_PUBLICO=

# --- Conexion con otras plataformas (Moodle, INFOP) ---------------------------
# Clave con la que se cifran las llaves de acceso guardadas.   openssl rand -hex 32
# Si se pierde o se cambia, los usuarios deben volver a vincular sus cuentas.
CLAVE_CIFRADO=
# true solo si se conectara un Moodle de la red interna o por http.
INTEGRACIONES_RED_PRIVADA=false

# --- Red ----------------------------------------------------------------------
# Origenes externos autorizados a consumir la API, separados por coma. Vacio = ninguno.
CORS_ORIGINS=
# Numero de proxies inversos delante de la aplicacion (0 = ninguno).
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Solo para pruebas --------------------------------------------------------
# PostgreSQL desechable con permiso CREATEDB.
PRUEBAS_DATABASE_URL=
