# Copia este archivo a .env y completa los valores. .env nunca se sube al repo.

# Base de datos y sesiones (genera valores largos y aleatorios: openssl rand -hex 32)
DB_PASSWORD=
JWT_SECRET=

# Autenticacion (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
CLERK_API_URL=https://api.clerk.com
# Clave publica PEM para validar JWT sin llamar a la API (una linea, saltos como \n)
CLERK_JWT_KEY=
