# Copie este archivo como .env y complete los valores. El archivo .env nunca se versiona.
# Generar secretos:  openssl rand -hex 48

NODE_ENV=production
PORT=8080

# Contrasena del usuario esoe_admin de PostgreSQL (obligatoria).
DB_PASSWORD=

# Secreto para firmar sesiones (obligatorio, minimo 32 caracteres).
JWT_SECRET=

# Origenes externos autorizados a consumir la API, separados por coma.
# Vacio = solo el mismo origen (recomendado).
CORS_ORIGINS=

# Numero de proxies inversos delante de la aplicacion (0 = ninguno).
TRUST_PROXY=0

# Limite de peticiones a /api por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Solo para pruebas de integracion: PostgreSQL desechable con permiso CREATEDB.
PRUEBAS_DATABASE_URL=
