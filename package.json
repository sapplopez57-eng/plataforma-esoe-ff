{
  "name": "plataforma-esoe-sms",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestion Academica y Escolar (SMS) - Escuela de Suboficiales del Ejercito (ESOE)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.js",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-branches=70 \"tests/*.test.js\"",
    "auditar": "npm audit --audit-level=high",
    "secretos": "node scripts/buscar-secretos.js",
    "estilo": "node scripts/estilo.js",
    "estilo:corregir": "node scripts/estilo.js --corregir",
    "verificar": "bash scripts/verificar.sh",
    "comprobar:despliegue": "node --env-file-if-exists=.env scripts/comprobar-despliegue.js",
    "localizacion": "node scripts/generar-localizacion.js",
    "construir:campus": "esbuild interfaz/campus3d/entrada.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=public/vendor/campus3d.js",
    "crear-root": "node --env-file-if-exists=.env scripts/crear-root.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.90",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@clerk/localizations": "^4.24.8",
    "@eslint/js": "^10.0.1",
    "acorn": "^8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "three": "0.187.0"
  }
}
